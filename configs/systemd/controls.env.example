# 复制为 /etc/stablecoin-gateway/controls-<资产ID>.env，权限 0600。
# 不要在这里设置两个资产ID：由 systemd 实例名绑定，启动前会再次校验。
# 账号需要读取业务/钱包数据、写入钱包快照和对账表，不需要签名或出款权限。
GATEWAY_DATABASE_URL='postgres://REPLACE_CONTROLS_USER:REPLACE_PASSWORD@db.internal:5432/gateway?sslmode=verify-full'
GATEWAY_PAYOUT_TRON_SOLIDITY_NODE_URL='https://REPLACE_TRUSTED_SOLIDITY_NODE'
GATEWAY_WALLET_SNAPSHOT_TIMEOUT=5m
# GATEWAY_TRON_API_KEY 按部署需要从密钥服务注入，不得提交到仓库。
