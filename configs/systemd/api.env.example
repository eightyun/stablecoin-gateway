# 由部署方写入真实值；不要提交填写后的文件。
# systemd EnvironmentFile 不是 Shell，不支持 export、变量展开或命令替换。
GATEWAY_DATABASE_URL='postgres://REPLACE_USER:REPLACE_PASSWORD@db.internal:5432/gateway?sslmode=verify-full'
GATEWAY_HTTP_ADDR=127.0.0.1:8080
GATEWAY_API_KEY_ENCRYPTION_KEYS='{"v1":"REPLACE_WITH_PERSISTED_32_BYTE_BASE64_KEY"}'
GATEWAY_API_KEY_ACTIVE_VERSION=v1
GATEWAY_SHUTDOWN_TIMEOUT=10s
